{
    "name": "nubo-db/dynoxide-laravel",
    "description": "Run Laravel's DynamoDB cache, sessions and failed jobs against Dynoxide in tests and local development.",
    "type": "library",
    "license": "MIT OR Apache-2.0",
    "keywords": ["laravel", "dynamodb", "dynoxide", "emulator", "testing", "cache"],
    "homepage": "https://dynoxide.dev",
    "support": {
        "issues": "https://github.com/nubo-db/dynoxide-laravel/issues",
        "source": "https://github.com/nubo-db/dynoxide-laravel"
    },
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.322.9",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "nubo-db/dynoxide": "^1.7"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.1",
        "symfony/cache": "^7.2 || ^8.0"
    },
    "autoload": {
        "psr-4": { "Dynoxide\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Dynoxide\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Dynoxide\\Laravel\\DynoxideServiceProvider"]
        }
    },
    "repositories": [
        { "type": "path", "url": "../dynoxide-php", "options": { "symlink": true, "versions": { "nubo-db/dynoxide": "1.7.0" } } }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
